{
  "version": 2,
  "buildCommand": "yarn build:all",
  "outputDirectory": "mosaic-dashboard/dist",
  "installCommand": "yarn install --frozen-lockfile",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/app/(.*)", "destination": "/editor/$1" },
    { "source": "/editor/(.*)", "destination": "/editor/$1" },
    {
      "source": "/((?!api|app|editor|assets|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
