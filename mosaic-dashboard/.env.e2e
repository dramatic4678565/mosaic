# Vite mode for the e2e suite (see playwright.config.ts).
#
# The suite serves pre-built bundles from `e2e/preview-server.mjs`, which mirrors
# `docker/nginx.conf`. That server mounts the editor at /editor/ rather than the
# nginx /app/, so the dashboard has to emit /editor/ URLs to match. Keeping the
# value in a Vite env file rather than an inline env var makes the build
# reproducible across platforms — `cross-env` is not a dependency of this repo
# and inline env assignment is not valid in cmd.exe.
#
# Run with: vite build --mode e2e
#
# VITE_ vars are the only ones Vite exposes to client code, which is why this is
# the mechanism and not a plain process env read.
#
# Scope: this file configures the *dashboard* build only.
# `scripts/build-e2e.mjs` builds the editor with its default (production) mode, so
# the editor's VITE_APP_WS_SERVER_URL comes from the root `.env.production`.

VITE_EDITOR_BASE=/editor

# Collaboration is not exercised by the e2e suite — it needs two browser
# contexts and a live room server. Declared here so the dashboard bundle never
# attempts a real network connection during a test run.
VITE_APP_WS_SERVER_URL=http://localhost:8081
# Storage backend: deliberately NOT set here.
#
# An absent 'VITE_API_URL' selects IndexedDB (see 'src/lib/storage/index.ts'), which
# is what the e2e suite needs. The preview server serves static bundles only - it
# runs no serverless functions - so an API-mode bundle would have every board
# request rejected by the connection refused, and the suite would fail for reasons
# that have nothing to do with what it is testing.
#
# Note the contrast with '.env.production', where the variable *is* set (to an
# empty string) to turn the API on. Same variable, opposite intent, because in both
# cases presence is the switch.
#
# This also keeps the suite hermetic: no test can reach a real Neon database, so no
# test can leak rows into or destroy a real user's boards.
