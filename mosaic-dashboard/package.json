{
  "name": "mosaic-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mosaic dashboard - boards, folders, favorites and activity tracking",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "tsc --noEmit && vite build --mode e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:e2e:dev": "playwright test --config=playwright.dev.config.ts",
    "test:e2e:collab": "playwright test --config=playwright.collab.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mosaic/brand": "0.1.0",
    "dexie": "4.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "6.30.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "3.1.0",
    "fake-indexeddb": "6.2.2",
    "jsdom": "22.1.0",
    "sass": "1.51.0",
    "typescript": "5.9.3",
    "vite": "5.0.12",
    "vitest": "3.0.6"
  }
}
