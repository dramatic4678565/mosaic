# Vite mode for the auth e2e suite (see playwright.auth.config.ts).
#
# The main e2e mode leaves VITE_API_URL unset so the dashboard falls back to
# IndexedDB and no server is ever contacted. That is right for CRUD coverage and
# useless for accounts: the magic-link journey, the guest hand-off and board
# sharing cannot be exercised without a server.
#
# So this mode turns the API on, against the in-memory mock in
# `e2e/mock-api.mjs`. The variable is empty rather than a URL because the mock is
# mounted on the same origin as the bundles — which is also how production works,
# with the functions alongside the static output. An empty value is what
# `lib/storage/index.ts` and `lib/auth.ts` treat as "API mode": the switch is
# *presence*, not truthiness.
VITE_API_URL=

# Same editor mount as the main e2e mode. The shared-board viewer renders an iframe
# into the editor's `#share=` mode, and that editor build has to be reachable.
VITE_EDITOR_BASE=/editor/

# Collaboration is not exercised by this suite. Declared so the dashboard bundle
# never attempts a real network connection during a test run.
VITE_APP_WS_SERVER_URL=http://localhost:8081
