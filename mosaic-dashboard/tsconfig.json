{
  "extends": "../packages/tsconfig.base.json",
  "compilerOptions": {
    /**
     * No `rootDir`: `@mosaic/brand` resolves to a sibling workspace package
     * (`packages/mosaic-brand/src`), which sits outside this directory. With
     * `noEmit` there is no output layout to constrain anyway, and declaring a
     * rootDir would only produce TS6059.
     */
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "baseUrl": ".",
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@mosaic/brand": ["../packages/mosaic-brand/src/index.ts"],
      "@mosaic/brand/*": ["../packages/mosaic-brand/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "e2e", "vite.config.mts", "vitest.config.mts"]
}
